# Production Caddyfile — installed to /etc/caddy/Caddyfile by scripts/deploy.sh.
# unixcore.sh, www and beta are proxied by Cloudflare (orange cloud, SSL mode Full
# (strict)); irc and sftp are DNS-only. Caddy still gets Let's Encrypt certs itself:
# the HTTP-01 challenge reaches it on port 80 through Cloudflare, so Cloudflare's
# "Always Use HTTPS" must stay off (Caddy does that redirect).
# The admin API stays on its default localhost:2019 so `systemctl reload caddy` works.
{
	servers {
		# Cloudflare's edge ranges (https://www.cloudflare.com/ips/, checked 2026-11-14).
		# Requests from these carry the visitor's address in CF-Connecting-IP, which
		# becomes {client_ip}. From anywhere else the header is ignored.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(unixcore) {
	root * /srv/unixcore/sites
	encode gzip

	# SFTPGo's browser file manager and the API it calls. The admin UI is not
	# exposed; reach it with `ssh -L 8080:127.0.0.1:8080 unixcore` then
	# http://localhost:8080/web/admin
	@sftpgo path /web/client* /api/v2/user* /static/*
	reverse_proxy @sftpgo 127.0.0.1:8080 {
		# The real visitor, not Cloudflare. Cloudflare appends to any X-Forwarded-For
		# the visitor sent, so passing that chain on would let them pick their own IP.
		header_up X-Forwarded-For {client_ip}
	}

	# Milk's heart-rate API still runs on the old box (box.sprojects.org:2096, an
	# Express server behind a Cloudflare Origin cert that browsers do not trust).
	# Proxy it here so pages can call /api/heartbeat same-origin, and so the
	# endpoint keeps working once unixcore.sh moves to this VPS.
	@heartbeat path /api/heartbeat* /api/healthcheck* /api/healtherror*
	reverse_proxy @heartbeat https://box.sprojects.org:2096 {
		transport http {
			tls_insecure_skip_verify
		}
	}

	# /terms is a static page shipped with the hub assets (bot/templates/hub/terms.html).
	rewrite /terms /_hub/terms.html
	rewrite /terms/ /_hub/terms.html

	# Guestbook: served by the bot process (bot/guestbook.ts) on localhost.
	@guestbook path /guestbook /guestbook/ /guestbook/latest
	reverse_proxy @guestbook 127.0.0.1:8090 {
		header_up X-Forwarded-For {client_ip}
	}

	# Without a Cache-Control, Cloudflare keeps images/css/js at its edge for 2 hours,
	# so a file someone re-uploads would stay stale. A minute keeps edits showing up
	# quickly. `?` leaves alone anything that sets its own.
	@cacheable not path /web/* /api/* /guestbook /guestbook/ /guestbook/latest
	header @cacheable ?Cache-Control "public, max-age=60"

	# never serve dotfiles (.DS_Store, .htaccess-alikes, etc.)
	@dot path */.*
	error @dot 404

	# Missing pages get the unixcore 404 (bot/templates/hub/404.html), with a real 404
	# status. A site can override it by putting its own 404.html in its folder.
	handle_errors 404 {
		root * /srv/unixcore/sites
		try_files /{http.request.uri.path.0}/404.html /_hub/404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	file_server
}

unixcore.sh, www.unixcore.sh, beta.unixcore.sh {
	import unixcore
}

# irc.unixcore.sh is the IRC hostname (Ergo on :6697, see infra/ergo.yaml). This block
# exists so Caddy keeps a Let's Encrypt cert for it, which scripts/ergo-certs.sh hands
# to Ergo. Browsers that wander here get sent to the hub.
irc.unixcore.sh {
	# The firewall only lets Cloudflare reach 80/443, and irc is DNS-only, so Let's
	# Encrypt can't do the HTTP challenge here: renew through Cloudflare DNS instead
	# (token from /etc/caddy/cloudflare.env, see infra/caddy-cloudflare.conf).
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	redir https://unixcore.sh{uri} 302
}

# The Android app uploads heart-rate readings to unixcore.sh:2096. 2096 is one of
# the HTTPS ports Cloudflare proxies, so it arrives here through Cloudflare and is
# passed on to the old box; the app needs no change.
unixcore.sh:2096 {
	reverse_proxy https://box.sprojects.org:2096 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
