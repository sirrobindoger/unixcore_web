# Production Caddyfile — installed to /etc/caddy/Caddyfile by scripts/deploy.sh.
# unixcore.sh DNS points straight at this VPS (no Cloudflare proxy), so Caddy
# gets Let's Encrypt certs itself. beta.unixcore.sh is kept as an alias.
# The admin API stays on its default localhost:2019 so `systemctl reload caddy` works.
(unixcore) {
	root * /srv/unixcore/sites
	encode gzip

	# SFTPGo's browser file manager and the API it calls. The admin UI is not
	# exposed; reach it with `ssh -L 8080:127.0.0.1:8080 unixcore` then
	# http://localhost:8080/web/admin
	@sftpgo path /web/client* /api/v2/user* /static/*
	reverse_proxy @sftpgo 127.0.0.1:8080

	# Milk's heart-rate API still runs on the old box (box.sprojects.org:2096, an
	# Express server behind a Cloudflare Origin cert that browsers do not trust).
	# Proxy it here so pages can call /api/heartbeat same-origin, and so the
	# endpoint keeps working once unixcore.sh moves to this VPS.
	@heartbeat path /api/heartbeat* /api/healthcheck* /api/healtherror*
	reverse_proxy @heartbeat https://box.sprojects.org:2096 {
		transport http {
			tls_insecure_skip_verify
		}
	}

	# /terms is a static page shipped with the hub assets (bot/templates/hub/terms.html).
	rewrite /terms /_hub/terms.html
	rewrite /terms/ /_hub/terms.html

	# Guestbook: served by the bot process (bot/guestbook.ts) on localhost.
	@guestbook path /guestbook /guestbook/
	reverse_proxy @guestbook 127.0.0.1:8090

	# never serve dotfiles (.DS_Store, .htaccess-alikes, etc.)
	@dot path */.*
	error @dot 404

	# Missing pages get the unixcore 404 (bot/templates/hub/404.html), with a real 404
	# status. A site can override it by putting its own 404.html in its folder.
	handle_errors 404 {
		root * /srv/unixcore/sites
		try_files /{http.request.uri.path.0}/404.html /_hub/404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	file_server
}

unixcore.sh, www.unixcore.sh, beta.unixcore.sh {
	import unixcore
}

# irc.unixcore.sh is the IRC hostname (Ergo on :6697, see infra/ergo.yaml). This block
# exists so Caddy keeps a Let's Encrypt cert for it, which scripts/ergo-certs.sh hands
# to Ergo. Browsers that wander here get sent to the hub.
irc.unixcore.sh {
	redir https://unixcore.sh{uri} 302
}

# The Android app uploads heart-rate readings to unixcore.sh:2096, which used to
# reach the old box through Cloudflare. Keep that port alive here and pass it
# through so the app needs no change.
unixcore.sh:2096 {
	reverse_proxy https://box.sprojects.org:2096 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
