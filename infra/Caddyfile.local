# Local demo: serves {SITES_DIR} on http://localhost:8000/<slug>/
# The VPS Caddyfile is the same block under `unixcore.sh {` (auto-HTTPS).
{
	admin off
}

:8000 {
	root * {$SITES_DIR}
	encode gzip

	# /terms is a static page shipped with the hub assets (bot/templates/hub/terms.html).
	rewrite /terms /_hub/terms.html
	rewrite /terms/ /_hub/terms.html

	# Guestbook: served by the bot process (bot/guestbook.ts) on localhost.
	@guestbook path /guestbook /guestbook/
	reverse_proxy @guestbook 127.0.0.1:8090

	# never serve dotfiles (.DS_Store, .htaccess-alikes, etc.)
	@dot path */.*
	error @dot 404

	# Missing pages get the unixcore 404 (bot/templates/hub/404.html), with a real 404
	# status. A site can override it by putting its own 404.html in its folder.
	handle_errors 404 {
		root * {$SITES_DIR}
		try_files /{http.request.uri.path.0}/404.html /_hub/404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	file_server
}
