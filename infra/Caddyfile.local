# Local demo: serves {SITES_DIR} on http://localhost:8000/<slug>/
# The VPS Caddyfile is the same block under `unixcore.sh {` (auto-HTTPS).
{
	admin off
}

:8000 {
	root * {$SITES_DIR}
	encode gzip

	# Guestbook: served by the bot process (bot/guestbook.ts) on localhost.
	@guestbook path /guestbook /guestbook/
	reverse_proxy @guestbook 127.0.0.1:8090

	# never serve dotfiles (.DS_Store, .htaccess-alikes, etc.)
	@dot path */.*
	respond @dot 404

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	file_server
}
