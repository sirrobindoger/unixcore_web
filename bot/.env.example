# Same keys as bnuuybot — reuse that bot's token/guild.
TOKEN=
GUILD_ID=
# Channel the site menu is posted into on startup (or run /site menu in a channel)
SITE_CHANNEL=
# Channel the site directory (phone book + site of the day) is posted into (or run /site directory there)
DIRECTORY_CHANNEL=

# SFTPGo admin API (bot talks to this over localhost). dev.sh also uses these
# to create the default admin on first boot.
SFTPGO_URL=http://127.0.0.1:8080
SFTPGO_ADMIN_USERNAME=admin
SFTPGO_ADMIN_PASSWORD=change-me

# What users are told. Local demo values; on the VPS these become
# https://unixcore.sh, unixcore.sh, 22, https://files.unixcore.sh
PUBLIC_URL=http://localhost:8000
SFTP_HOST=localhost
SFTP_PORT=2022
WEBCLIENT_URL=http://localhost:8080/web/client

# Per-site quota
QUOTA_MB=100

# Guestbook (/guestbook). Cloudflare Turnstile keys from
# dash.cloudflare.com → Turnstile → Add widget (hostname unixcore.sh).
# Leave blank locally and the always-pass test keys are used.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Where the bot's little HTTP server listens; Caddy proxies /guestbook here.
GUESTBOOK_HOST=127.0.0.1
GUESTBOOK_PORT=8090
# Salt for the stored per-post IP hash (any random string).
GUESTBOOK_IP_SALT=

# Paths (relative to repo root unless absolute)
SITES_DIR=sites
SUSPENDED_DIR=suspended
TRASH_DIR=trash
DB_PATH=data/unixcore.db
